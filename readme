├── ingestion/
│   └── lectura_csv.py
├── logs/
│   ├── pipeline.log
│   └── reporte_calidad.json
├── modelo/
│   ├── eda_modelo.py
│   └── modelo_ia.py
├── output/
│   ├── eda/
│   └── modelo/
├── procesamiento/
│   └── transformacion.py
